{
  "color": {
    "$type": "color",
    "primary": {
      "50": {
        "$value": "#FCEBEE"
      },
      "600": {
        "$value": "#C8102E"
      },
      "700": {
        "$value": "#9E0C24"
      }
    },
    "neutral": {
      "0": {
        "$value": "#FFFFFF"
      },
      "50": {
        "$value": "#F8F9FA"
      },
      "100": {
        "$value": "#F1F3F5"
      },
      "200": {
        "$value": "#DCE1E5"
      },
      "400": {
        "$value": "#9AA2AB"
      },
      "500": {
        "$value": "#8A939D"
      },
      "600": {
        "$value": "#68717C"
      },
      "700": {
        "$value": "#4A525C"
      },
      "900": {
        "$value": "#12161C"
      }
    },
    "green": {
      "50": {
        "$value": "#EDF7EF"
      },
      "600": {
        "$value": "#2E844A"
      },
      "700": {
        "$value": "#1B6B32"
      }
    },
    "amber": {
      "50": {
        "$value": "#FFF5E0"
      },
      "600": {
        "$value": "#B86E00"
      },
      "700": {
        "$value": "#8A4B00"
      }
    },
    "red": {
      "50": {
        "$value": "#FDECEC"
      },
      "600": {
        "$value": "#D23A3A"
      },
      "700": {
        "$value": "#A61B1B"
      }
    },
    "blue": {
      "50": {
        "$value": "#EAF1FC"
      },
      "600": {
        "$value": "#3570D4"
      },
      "700": {
        "$value": "#1D4F9C"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    }
  },
  "surface": {
    "$type": "color",
    "action": {
      "$value": "{color.primary.600}"
    },
    "action-hover": {
      "$value": "{color.primary.700}"
    },
    "subtle": {
      "$value": "{color.neutral.100}"
    },
    "selected": {
      "$value": "{color.primary.50}"
    },
    "hover": {
      "$value": "{color.neutral.50}"
    },
    "page": {
      "$value": "{color.neutral.0}"
    },
    "disabled": {
      "$value": "{color.neutral.100}"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "pill": {
      "$value": "999px"
    }
  },
  "border": {
    "$type": "color",
    "default": {
      "$value": "{color.neutral.200}"
    },
    "strong": {
      "$value": "{color.neutral.500}"
    },
    "hover": {
      "$value": "{color.neutral.700}"
    },
    "width": {
      "$type": "dimension",
      "thin": {
        "$value": "1px"
      }
    }
  },
  "font-size": {
    "$type": "dimension",
    "sm": {
      "$value": "12px"
    },
    "md": {
      "$value": "14px"
    },
    "lg": {
      "$value": "16px"
    },
    "xl": {
      "$value": "20px"
    },
    "2xl": {
      "$value": "24px"
    }
  },
  "text": {
    "$type": "color",
    "on-action": {
      "$value": "{color.neutral.0}"
    },
    "default": {
      "$value": "{color.neutral.900}"
    },
    "muted": {
      "$value": "{color.neutral.600}"
    },
    "placeholder": {
      "$value": "{color.neutral.600}"
    },
    "disabled": {
      "$value": "{color.neutral.400}"
    }
  },
  "focus": {
    "ring": {
      "color": {
        "$type": "color",
        "$value": "{color.blue.600}"
      },
      "width": {
        "$type": "dimension",
        "$value": "2px"
      },
      "offset": {
        "$type": "dimension",
        "$value": "2px"
      }
    }
  },
  "feedback": {
    "$type": "color",
    "success": {
      "surface": {
        "$value": "{color.green.50}"
      },
      "text": {
        "$value": "{color.green.700}"
      },
      "border": {
        "$value": "{color.green.600}"
      }
    },
    "warning": {
      "surface": {
        "$value": "{color.amber.50}"
      },
      "text": {
        "$value": "{color.amber.700}"
      },
      "border": {
        "$value": "{color.amber.600}"
      }
    },
    "danger": {
      "surface": {
        "$value": "{color.red.50}"
      },
      "text": {
        "$value": "{color.red.700}"
      },
      "border": {
        "$value": "{color.red.600}"
      }
    },
    "info": {
      "surface": {
        "$value": "{color.blue.50}"
      },
      "text": {
        "$value": "{color.blue.700}"
      },
      "border": {
        "$value": "{color.blue.600}"
      }
    }
  },
  "line-height": {
    "$type": "number",
    "tight": {
      "$value": 1
    },
    "normal": {
      "$value": 1.5
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    },
    "bold": {
      "$value": 700
    }
  },
  "size": {
    "$type": "dimension",
    "checkbox": {
      "$value": "16px"
    },
    "avatar": {
      "sm": {
        "$value": "24px"
      },
      "md": {
        "$value": "40px"
      }
    },
    "icon": {
      "sm": {
        "$value": "16px"
      },
      "md": {
        "$value": "20px"
      }
    }
  },
  "font-family": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "elevation": {
    "$type": "shadow",
    "sm": {
      "$description": "Subtle resting shadow for cards and surfaces.",
      "$value": [
        {
          "color": "#12161C0D",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        },
        {
          "color": "#12161C1A",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ]
    }
  },
  "$themes": [],
  "$metadata": {
    "tokenSetOrder": [
      "color",
      "space",
      "surface",
      "radius",
      "border",
      "font-size",
      "text",
      "focus",
      "feedback",
      "line-height",
      "font-weight",
      "size",
      "font-family",
      "elevation"
    ]
  }
}
